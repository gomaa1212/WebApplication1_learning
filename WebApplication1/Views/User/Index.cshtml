
@model IEnumerable<GetUsersViewModel>

@{
    ViewData["Title"] = "Users";
}

<script src="~/lib/jquery/jquery.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        toastr.success('@TempData["SuccessMessage"]');
    </script>
}

@if (TempData["DeleteMessage"] != null)
{
    <script>
        toastr.success('@TempData["DeleteMessage"]');
    </script>
}

@if (TempData["EditMessage"] != null)
{
    <script>
        toastr.success('@TempData["EditMessage"]');
    </script>
}


<div class="container-fluid mt-4 mb-5">

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>

                    <h2 class="fw-bold mb-1">
                        Users
                    </h2>

                    <p class="text-muted mb-0">
                        Manage application users
                    </p>

                </div>

                <span class="badge bg-primary users-count">
                    @Model.Count() Users
                </span>

            </div>


            <!-- Table -->
            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center users-table">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                @Html.DisplayNameFor(model => model.FullName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Email)
                            </th>

                            <th>
                                User Name
                            </th>

                            <th>
                                Address
                            </th>

                            <th>
                                Roles
                            </th>

                            <th class="actions-column">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Full Name -->
                                <td class="fw-semibold">
                                    @Html.DisplayFor(model => item.FullName)
                                </td>


                                <!-- Email -->
                                <td>
                                    @Html.DisplayFor(model => item.Email)
                                </td>


                                <!-- Username -->
                                <td>

                                    <span class="badge bg-primary username-badge">
                                        @Html.DisplayFor(model => item.UserName)
                                    </span>

                                </td>


                                <!-- Address -->
                                <td>
                                    @Html.DisplayFor(model => item.Address)
                                </td>


                                <!-- Roles -->
                                <td>

                                    @if (item.RoleName != null && item.RoleName.Any())
                                    {
                                        foreach (var role in item.RoleName)
                                        {
                                            <span class="badge bg-secondary role-badge">
                                                @role
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No Roles
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>


                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">

                                            Details

                                        </a>


                                        <a asp-action="ManageRolesInUser"
                                           asp-route-Id="@item.Id"
                                           class="btn btn-primary btn-sm">

                                            Manage Roles

                                        </a>

                                        <a asp-action="ManageUserClaims"
                                           asp-route-Id="@item.Id"
                                           class="btn btn-primary btn-sm">

                                            Manage Claims

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    .users-table {
        margin-bottom: 0;
    }

        .users-table th {
            white-space: nowrap;
            padding: 14px 16px;
        }

        .users-table td {
            vertical-align: middle;
            padding: 14px 12px;
        }

        .users-table tbody tr {
            transition: all 0.2s ease;
        }

            .users-table tbody tr:hover {
                transform: translateY(-1px);
            }


    /* Username */
    .username-badge {
        padding: 8px 12px;
        font-weight: 500;
    }


    /* Roles */
    .role-badge {
        display: inline-block;
        margin: 2px;
        padding: 6px 10px;
        font-weight: 500;
    }


    /* Users Count */
    .users-count {
        padding: 9px 16px;
        font-size: 14px;
        font-weight: 500;
    }


    /* Actions */
    .actions-column {
        min-width: 280px;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            min-width: 75px;
        }

        .action-buttons .btn-primary {
            min-width: 115px;
        }


    /* Mobile */
    @@media (max-width: 768px) {

        .card-body {
            padding: 1rem !important;
        }

        .users-table {
            font-size: 14px;
        }

        .actions-column {
            min-width: 200px;
        }

        .action-buttons {
            justify-content: flex-start;
        }
    }

</style>

