
@model GetUserByIdViewModel

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5 mb-5">

    <div class="card shadow-sm border-danger">

        <!-- Header -->
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0">
                Delete User
            </h4>
        </div>

        <div class="card-body p-4">

            <div class="mb-4">
                <h5 class="fw-bold">
                    Are you sure you want to delete this user?
                </h5>

                <p class="text-muted mb-0">
                    This action cannot be undone.
                </p>
            </div>


            <!-- User Information -->
            <div class="user-info-card mb-4">

                <div class="row g-4">

                    <!-- Full Name -->
                    <div class="col-md-6">

                        <div class="info-label">
                            Full Name
                        </div>

                        <div class="info-value">
                            @Model.FullName
                        </div>

                    </div>


                    <!-- Username -->
                    <div class="col-md-6">

                        <div class="info-label">
                            Username
                        </div>

                        <div class="info-value">
                            @Model.UserName
                        </div>

                    </div>


                    <!-- Email -->
                    <div class="col-md-6">

                        <div class="info-label">
                            Email
                        </div>

                        <div class="info-value">
                            @Model.Email
                        </div>

                    </div>


                    <!-- Address -->
                    <div class="col-md-6">

                        <div class="info-label">
                            Address
                        </div>

                        <div class="info-value">
                            @Model.Address
                        </div>

                    </div>

                </div>

            </div>


            <!-- Delete Form -->
            <form asp-controller="User"
                  asp-action="Delete"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <button type="submit"
                        class="btn btn-danger px-4">

                    <i class="bi bi-trash"></i>
                    Delete User

                </button>

                <a asp-controller="User"
                   asp-action="Index"
                   class="btn btn-secondary px-4 ms-2">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>


<style>

    .user-info-card {
        background-color: #f8f9fa;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 25px;
    }

    .info-label {
        font-size: 13px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: 16px;
        font-weight: 500;
        color: #212529;
        word-break: break-word;
    }

</style>

