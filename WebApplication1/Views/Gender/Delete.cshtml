@model GetAllGenderViewModel

@{
    ViewData["Title"] = "Delete Gender";
}

<div class="container mt-4">

    <div class="card shadow-sm border-danger">

        <div class="card-body">

            <!-- Header -->
            <div class="mb-4">

                <h2 class="fw-bold text-danger mb-1">
                    Delete Gender
                </h2>

                <p class="text-muted mb-0">
                    Are you sure you want to delete this gender?
                </p>

            </div>


            <!-- Gender Information -->
            <div class="card bg-light mb-4">

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Id</strong>
                            <div class="mt-1">
                                @Model.id
                            </div>
                        </div>


                        <div class="col-md-4">
                            <strong>Gender</strong>
                            <div class="mt-1">
                                @Model.name
                            </div>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Delete Form -->
            <form asp-controller="Gender"
                  asp-action="Delete"
                  method="post">

                <input asp-for="id" type="hidden" />


                <button type="submit"
                        class="btn btn-danger">

                    Delete

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary ms-2">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>