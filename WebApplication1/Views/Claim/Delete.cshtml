@model GetClaimByIdViewModel

@{
    ViewData["Title"] = "Delete Claim";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-4">
                <h2 class="fw-bold mb-1 text-danger">
                    Delete Claim
                </h2>

                <p class="text-muted mb-0">
                    Are you sure you want to delete this claim?
                </p>
            </div>


            <div class="alert alert-warning">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>


            <!-- Claim Information -->
            <div class="mb-4">

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Claim Name
                    </label>

                    <input value="@Model.Name"
                           class="form-control"
                           readonly />
                </div>


                


                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Is User Claim
                    </label>

                    <input value="@(Model.IsUserClaim ? "Yes" : "No")"
                           class="form-control"
                           readonly />
                </div>


                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Is Role Claim
                    </label>

                    <input value="@(Model.IsRoleClaim ? "Yes" : "No")"
                           class="form-control"
                           readonly />
                </div>

            </div>


            <!-- Buttons -->
            <form asp-controller="Claim"
                  asp-action="Delete"
                  method="post">

                <input asp-for="Id" type="hidden" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>