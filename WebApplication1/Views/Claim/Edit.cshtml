@model UpdateClaimViewModel

@{
    ViewData["Title"] = "Edit Claim";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-4">

                <h2 class="fw-bold mb-1">
                    Edit Claim
                </h2>

                <p class="text-muted mb-0">
                    Update claim information
                </p>

            </div>


            <form asp-controller="Claim"
                  asp-action="Edit"
                  method="post">

                <!-- Hidden Id -->
                <input asp-for="Id" type="hidden" />


                <!-- Claim English -->
                <div class="mb-3">

                    <label asp-for="NameEn"
                           class="form-label fw-semibold">
                        Claim English
                    </label>

                    <input asp-for="NameEn"
                           class="form-control"
                           placeholder="Enter claim in English" />

                    <span asp-validation-for="NameEn"
                          class="text-danger">
                    </span>

                </div>


                <!-- Claim Arabic -->
                <div class="mb-3">

                    <label asp-for="NameAr"
                           class="form-label fw-semibold">
                        Claim Arabic
                    </label>

                    <input asp-for="NameAr"
                           class="form-control"
                           placeholder="Enter claim in Arabic" />

                    <span asp-validation-for="NameAr"
                          class="text-danger">
                    </span>

                </div>


                <!-- Is User Claim -->
                <div class="mb-3">

                    <label asp-for="IsUserClaim"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="IsUserClaim"
                            class="form-control"
                            asp-items="@(ViewBag.ChooseUserClaim)">
                    </select>

                    <span asp-validation-for="IsUserClaim"
                          class="text-danger">
                    </span>

                </div>


                <!-- Is Role Claim -->
                <div class="mb-3">

                    <label asp-for="IsRoleClaim"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="IsRoleClaim"
                            class="form-control"
                            asp-items="@(ViewBag.ChooseRoleClaim)">
                    </select>

                    <span asp-validation-for="IsRoleClaim"
                          class="text-danger">
                    </span>

                </div>


                <!-- Buttons -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-warning">
                        Update
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">
                        Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Script {
    <partial name="_ValidationScriptsPartial" />
}