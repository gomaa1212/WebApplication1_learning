
@model RegisterViewModel

<section class="register-section">
    <div class="register-overlay">
        <div class="container">
            <div class="row justify-content-center align-items-center min-vh-100 py-5">

                <div class="col-12 col-lg-9 col-xl-8">

                    <div class="register-card">

                        <div class="register-header">
                            <h2>Create an Account</h2>
                            <p>Fill in the information below to create your account.</p>
                        </div>

                        <form asp-action="Register" method="post">

                            <div asp-validation-summary="All"
                                 class="text-danger validation-summary">
                            </div>

                            <div class="row">

                                <!-- English Name -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="FullNameEn">
                                            Full Name (English)
                                        </label>

                                        <input asp-for="FullNameEn"
                                               class="form-control custom-input"
                                               placeholder="Enter your full name" />

                                        <span asp-validation-for="FullNameEn"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- Arabic Name -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="FullNameAr">
                                            Full Name (Arabic)
                                        </label>

                                        <input asp-for="FullNameAr"
                                               class="form-control custom-input"
                                               placeholder="أدخل اسمك الكامل" />

                                        <span asp-validation-for="FullNameAr"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- Username -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="UserName">
                                            Username
                                        </label>

                                        <input asp-for="UserName"
                                               class="form-control custom-input"
                                               placeholder="Enter your username" />

                                        <span asp-validation-for="UserName"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="Email">
                                            Email
                                        </label>

                                        <input asp-for="Email"
                                               type="email"
                                               class="form-control custom-input"
                                               placeholder="Enter your email" />

                                        <span asp-validation-for="Email"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- Password -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="Password">
                                            Password
                                        </label>

                                        <input asp-for="Password"
                                               type="password"
                                               class="form-control custom-input"
                                               placeholder="Enter your password" />

                                        <span asp-validation-for="Password"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- Confirm Password -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="ConfirmPassword">
                                            Confirm Password
                                        </label>

                                        <input asp-for="ConfirmPassword"
                                               type="password"
                                               class="form-control custom-input"
                                               placeholder="Repeat your password" />

                                        <span asp-validation-for="ConfirmPassword"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- English Address -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="AddressEn">
                                            Address (English)
                                        </label>

                                        <input asp-for="AddressEn"
                                               class="form-control custom-input"
                                               placeholder="Enter your address" />

                                        <span asp-validation-for="AddressEn"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                <!-- Arabic Address -->
                                <div class="col-md-6">
                                    <div class="input-group-custom">

                                        <label asp-for="AddressAr">
                                            Address (Arabic)
                                        </label>

                                        <input asp-for="AddressAr"
                                               class="form-control custom-input"
                                               placeholder="أدخل العنوان" />

                                        <span asp-validation-for="AddressAr"
                                              class="text-danger">
                                        </span>

                                    </div>
                                </div>

                                

                            </div>

                            <!-- Terms -->
                            <div class="terms-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="terms"
                                       required />

                                <label for="terms">
                                    I agree to all statements in
                                    <a href="#!" class="terms-link">
                                        Terms of Service
                                    </a>
                                </label>

                            </div>

                            <!-- Register Button -->
                            <button type="submit"
                                    class="register-btn">
                                Create Account
                            </button>

                            <!-- Login -->
                            <div class="login-text">
                                Already have an account?
                                <a asp-action="LogIn">
                                    Login here
                                </a>
                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>


<style>

    .register-section {
        min-height: 100vh;
        background-image: url('https://mdbcdn.b-cdn.net/img/Photos/new-templates/search-box/img4.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .register-overlay {
        min-height: 100vh;
        background: linear-gradient( 135deg, rgba(132, 250, 176, 0.45), rgba(143, 211, 244, 0.55) );
        display: flex;
        align-items: center;
    }

    .register-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 22px;
        padding: 45px 50px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    }

    .register-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .register-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: #222;
            margin-bottom: 8px;
        }

        .register-header p {
            color: #777;
            margin: 0;
            font-size: 14px;
        }

    .input-group-custom {
        margin-bottom: 20px;
    }

        .input-group-custom label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

    .custom-input {
        height: 50px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .custom-input:focus {
            border-color: #65c98a;
            box-shadow: 0 0 0 3px rgba(101, 201, 138, 0.15);
        }

    select.custom-input {
        cursor: pointer;
    }

    .terms-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 10px 0 25px;
        color: #666;
        font-size: 14px;
    }

        .terms-check .form-check-input {
            margin: 0;
            cursor: pointer;
        }

        .terms-check label {
            cursor: pointer;
        }

    .terms-link {
        color: #42a86b;
        font-weight: 600;
        text-decoration: none;
    }

        .terms-link:hover {
            text-decoration: underline;
        }

    .register-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( to right, #84fab0, #8fd3f4 );
        color: #1d1d1d;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .register-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .login-text {
        text-align: center;
        margin-top: 25px;
        color: #777;
        font-size: 14px;
    }

        .login-text a {
            color: #42a86b;
            font-weight: 600;
            text-decoration: none;
        }

            .login-text a:hover {
                text-decoration: underline;
            }

    .validation-summary {
        margin-bottom: 15px;
    }

    @@media (max-width: 767px) {

        .register-card {
            padding: 35px 25px;
            border-radius: 18px;
        }

        .register-header h2 {
            font-size: 27px;
        }

        .input-group-custom {
            margin-bottom: 18px;
        }
    }

</style>


@section Script {
    <partial name="_ValidationScriptsPartial" />
}

