
@model ResetPasswordViewModel

<section class="login-section">
    <div class="login-overlay">
        <div class="container">
            <div class="row justify-content-center align-items-center min-vh-100 py-5">

                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                    <div class="login-card">

                        <div class="login-header">
                            <h2>Reset Password</h2>
                            <p>
                                Create a new password for your account.
                            </p>
                        </div>

                        <form asp-action="ResetPassword" method="post">

                            <input asp-for="Email" type="hidden" />
                            <input asp-for="Token" type="hidden" />

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger validation-summary">
                            </div>

                            <!-- New Password -->
                            <div class="input-group-custom">

                                <label asp-for="NewPassword">
                                    New Password
                                </label>

                                <input asp-for="NewPassword"
                                       type="password"
                                       class="form-control custom-input"
                                       placeholder="Enter your new password" />

                                <span asp-validation-for="NewPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- Confirm Password -->
                            <div class="input-group-custom">

                                <label asp-for="ConfirmNewPassword">
                                    Confirm New Password
                                </label>

                                <input asp-for="ConfirmNewPassword"
                                       type="password"
                                       class="form-control custom-input"
                                       placeholder="Repeat your new password" />

                                <span asp-validation-for="ConfirmNewPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <button type="submit"
                                    class="login-btn">
                                Reset Password
                            </button>

                            <div class="register-text">
                                Remember your password?
                                <a asp-action="LogIn">
                                    Back to Login
                                </a>
                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>


<style>

    .login-section {
        min-height: 100vh;
        background-image: url('https://mdbcdn.b-cdn.net/img/Photos/new-templates/search-box/img4.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .login-overlay {
        min-height: 100vh;
        background: linear-gradient( 135deg, rgba(132, 250, 176, 0.45), rgba(143, 211, 244, 0.55) );
        display: flex;
        align-items: center;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 22px;
        padding: 45px 42px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    }

    .login-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .login-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: #222;
            margin-bottom: 10px;
        }

        .login-header p {
            color: #777;
            margin: 0;
            font-size: 14px;
            line-height: 1.6;
        }

    .input-group-custom {
        margin-bottom: 22px;
    }

        .input-group-custom label {
            display: block;
            font-size: 15px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

    .custom-input {
        height: 52px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 15px;
        transition: all 0.2s ease;
    }

        .custom-input:focus {
            border-color: #65c98a;
            box-shadow: 0 0 0 3px rgba(101, 201, 138, 0.15);
        }

    .login-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( to right, #84fab0, #8fd3f4 );
        color: #1d1d1d;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .register-text {
        text-align: center;
        margin-top: 25px;
        color: #777;
        font-size: 14px;
    }

        .register-text a {
            color: #42a86b;
            font-weight: 600;
            text-decoration: none;
        }

            .register-text a:hover {
                text-decoration: underline;
            }

    .validation-summary {
        margin-bottom: 15px;
    }

    @@media (max-width: 576px) {

        .login-card {
            padding: 35px 25px;
            border-radius: 18px;
        }

        .login-header h2 {
            font-size: 27px;
        }
    }

</style>


@section Script {
    <partial name="_ValidationScriptsPartial" />
}

