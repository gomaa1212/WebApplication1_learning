@model LogInViewModel

<script src="~/lib/jquery/jquery.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        toastr.success('@TempData["SuccessMessage"]');
    </script>
}

<section class="login-section">
    <div class="login-overlay">
        <div class="container">
            <div class="row justify-content-center align-items-center min-vh-100 py-5">

                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                    <div class="login-card">

                        <div class="login-header">
                            <h2>Welcome Back</h2>
                            <p>Login to your account</p>
                        </div>

                        <form asp-action="LogIn"
                              method="post"
                              asp-route-returnUrl="@ViewData["ReturnUrl"]">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger validation-summary">
                            </div>

                            <!-- Email / Username -->
                            <div class="input-group-custom">
                                <label asp-for="EmailOrUsername">
                                    Email or Username
                                </label>

                                <input type="text"
                                       asp-for="EmailOrUsername"
                                       class="form-control custom-input"
                                       placeholder="Enter your email or username" />

                                <span asp-validation-for="EmailOrUsername"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Password -->
                            <div class="input-group-custom">
                                <label asp-for="Password">
                                    Password
                                </label>

                                <input type="password"
                                       asp-for="Password"
                                       class="form-control custom-input"
                                       placeholder="Enter your password" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Remember Me -->
                            <div class="remember-row">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           asp-for="RememberMe" />

                                    <label class="form-check-label"
                                           asp-for="RememberMe">
                                        Remember me
                                    </label>
                                </div>

                                <a asp-action="ForgetPassword"
                                   class="forgot-link">
                                    Forgot Password?
                                </a>
                            </div>

                            <!-- Login Button -->
                            <button type="submit"
                                    class="login-btn">
                                Log In
                            </button>

                            <!-- Register -->
                            <div class="register-text">
                                Don't have an account?
                                <a asp-action="Register">
                                    Sign up
                                </a>
                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>


<style>

    .login-section {
        min-height: 100vh;
        background-image: url('https://mdbcdn.b-cdn.net/img/Photos/new-templates/search-box/img4.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .login-overlay {
        min-height: 100vh;
        background: linear-gradient( 135deg, rgba(132, 250, 176, 0.45), rgba(143, 211, 244, 0.55) );
        display: flex;
        align-items: center;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 22px;
        padding: 45px 42px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    }

    .login-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .login-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: #222;
            margin-bottom: 8px;
        }

        .login-header p {
            color: #777;
            margin: 0;
            font-size: 15px;
        }

    .input-group-custom {
        margin-bottom: 22px;
    }

        .input-group-custom label {
            display: block;
            font-size: 15px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

    .custom-input {
        height: 52px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 15px;
        transition: all 0.2s ease;
    }

        .custom-input:focus {
            border-color: #65c98a;
            box-shadow: 0 0 0 3px rgba(101, 201, 138, 0.15);
        }

    .remember-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 5px 0 25px;
        font-size: 14px;
    }

    .form-check {
        margin: 0;
    }

    .form-check-input {
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
        color: #555;
    }

    .forgot-link {
        color: #42a86b;
        text-decoration: none;
        font-weight: 500;
    }

        .forgot-link:hover {
            text-decoration: underline;
        }

    .login-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( to right, #84fab0, #8fd3f4 );
        color: #1d1d1d;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .register-text {
        text-align: center;
        margin-top: 25px;
        color: #777;
        font-size: 14px;
    }

        .register-text a {
            color: #42a86b;
            font-weight: 600;
            text-decoration: none;
        }

            .register-text a:hover {
                text-decoration: underline;
            }

    .validation-summary {
        margin-bottom: 15px;
    }

     

        .login-card {
            padding: 35px 25px;
            border-radius: 18px;
        }

        .login-header h2 {
            font-size: 27px;
        }

        .remember-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    

</style>

@section Script {
    <partial name="_ValidationScriptsPartial" />
}