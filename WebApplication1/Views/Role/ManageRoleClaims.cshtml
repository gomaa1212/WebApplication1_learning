@model List<ManageRoleClaimsViewModel>

@{
    ViewData["Title"] = "Manage Claims In Role";
}

<div class="container mt-5 mb-5">

    <div class="card shadow-sm">

        <!-- Header -->
        <div class="card-header bg-success text-white py-3">
            <h4 class="mb-0">
                Manage Claims In User @ViewData["UserName"]
            </h4>
        </div>

        <div class="card-body p-4">

            <div class="mb-4">
                <h5 class="fw-bold">
                    Select Claims
                </h5>

                <p class="text-muted mb-0">
                    Select the Claims you want to assign to this role.
                </p>
            </div>


            <form asp-action="ManageRoleClaims" method="post">

                
                <div class="users-list">

                    @for (int i = 0; i < Model.Count(); i++)
                    {
                        <label class="user-row">
                            <input asp-for="@Model[i].IsSelected" type="checkbox" class="form-check-input user-checkbox" />
                            <input asp-for="@Model[i].ClaimName" type="hidden" />
                            <div class="user-info">

                                <div class="user-name">
                                    @Model[i].ClaimName
                                </div>

                                

                            </div>

                        </label>
                    }

                </div>


                <!-- Actions -->
                <div class="actions mt-4">

                    <button type="submit"
                            class="btn btn-success px-4">

                        Update Roles

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary px-4 ms-2">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .users-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .user-row {
        display: flex;
        align-items: center;
        padding: 15px 18px;
        background-color: #f8f9fa;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .user-row:hover {
            background-color: #eefaf2;
            border-color: #84fab0;
        }

    .user-checkbox {
        width: 18px;
        height: 18px;
        margin-right: 15px;
        cursor: pointer;
    }

        .user-checkbox:checked {
            background-color: #198754;
            border-color: #198754;
        }

    .user-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .user-name {
        font-size: 15px;
        font-weight: 600;
        color: #212529;
    }

    .user-email {
        font-size: 13px;
        color: #6c757d;
    }

    .actions {
        border-top: 1px solid #eee;
        padding-top: 20px;
    }

</style>

