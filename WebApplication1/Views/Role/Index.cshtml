
@model IEnumerable<GetRolesViewModel>

@{
    ViewData["Title"] = "Roles";
}

<script src="~/lib/jquery/jquery.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        toastr.success('@TempData["SuccessMessage"]');
    </script>
}

@if (TempData["DeleteMessage"] != null)
{
    <script>
        toastr.success('@TempData["DeleteMessage"]');
    </script>
}

@if (TempData["EditMessage"] != null)
{
    <script>
        toastr.success('@TempData["EditMessage"]');
    </script>
}


<div class="container-fluid mt-4 mb-5">

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        Roles
                    </h2>

                    <p class="text-muted mb-0">
                        Manage application roles and their users
                    </p>
                </div>

                <a asp-action="Create"
                   class="btn btn-success px-4">

                    + Create New

                </a>

            </div>


            <!-- Roles Table -->
            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center roles-table">

                    <thead>

                        <tr>

                            <th>
                                Role Name
                            </th>

                            <th class="text-center actions-column">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Role Name -->
                                <td>

                                    <div class="role-name">
                                        @item.Name
                                    </div>

                                    <small class="text-muted">
                                        ID: @item.Id
                                    </small>

                                </td>


                                <!-- Actions -->
                                <td class="text-center">

                                    <div class="action-buttons">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>


                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white">

                                            Details

                                        </a>


                                        <a asp-action="ManageUsersInRole"
                                           asp-route-Id="@item.Id"
                                           class="btn btn-primary btn-sm">

                                            Manage Users

                                        </a>

                                        <a asp-action="ManageRoleClaims"
                                           asp-route-Id="@item.Id"
                                           class="btn btn-primary btn-sm">

                                            Manage Claims

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    .roles-table {
        margin-bottom: 0;
    }

        .roles-table thead th {
            background-color: #212529;
            color: white;
            padding: 14px 16px;
            font-size: 14px;
            font-weight: 600;
            border: none;
        }

        .roles-table tbody td {
            padding: 16px;
        }

        .roles-table tbody tr {
            transition: all 0.2s ease;
        }

            .roles-table tbody tr:hover {
                background-color: #f8f9fa;
            }

    .role-name {
        font-size: 16px;
        font-weight: 600;
        color: #212529;
    }

    .actions-column {
        width: 420px;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

        .action-buttons .btn {
            min-width: 75px;
        }

        .action-buttons .btn-primary {
            min-width: 115px;
        }

    @@media (max-width: 768px) {

        .card-body {
            padding: 20px !important;
        }

        .actions-column {
            width: auto;
        }

        .action-buttons {
            justify-content: flex-start;
        }
    }

</style>

