<div>

    <h1>@TempData["Message"]</h1>

</div>


<!-- AJAX Search with JSON -->

<div class="col-md-6 mb-4">

    <input type="text"
           id="searchInput"
           class="form-control"
           placeholder="Search by student name..." />

</div>


<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle text-center">

                <thead class="table-dark">

                    <tr>

                        <th>Id</th>

                        <th>Name</th>

                        <th>Gender</th>

                        <th>Default Image</th>

                        <th style="min-width: 250px;">
                            Additional Student Images
                        </th>

                        <th colspan="3">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="studentList">
                </tbody>


            </table>

        </div>

    </div>

</div>


<style>

    /* Default Student Image */

    .student-default-image {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }


    /* Container for additional images */

    .student-images {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        max-width: 300px;
        margin: auto;
    }


    /* Additional images */

    .student-additional-image {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.12);
        transition: 0.2s;
    }


        .student-additional-image:hover {
            transform: scale(1.15);
            box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        }

</style>

@section Script{


<script>

    $(document).ready(function() {

        $('#searchInput').on('keyup', function() {

            var name = $(this).val();

            console.log("Search:", name);


            $.ajax({

                url: '@Url.Action("SearchByNameWithJson", "Student")',

                type: 'POST',

                data: { name: name },

                success: function(data) {

                    $('#studentList').empty();

                    $.each(data, function(index, student) {

                        console.log(student);

                            var images = student.studentImages.map(function(image) {

                                return '<img src="/' +
                                    image.fileUrl +
                                    '" class="student-additional-image" />';

                            }).join('');

                        $('#studentList').append(

                            '<tr>' +

                            '<td>' + student.id + '</td>' +

                            '<td>' + student.name + '</td>' +

                            '<td>' + student.genderName + '</td>' +

                            '<td>' +
                            '<img src="/' + student.fileUrl + '" class="student-default-image" />' +
                            '</td>' +

                            '<td>' +
                            '<div class="student-images">' +
								images +
                            '</div>' +
                            '</td>' +

                            '<td>' +
                            '<a href="/Student/Details/' + student.id + '" class="btn btn-info btn-sm">' +
                            'Details' +
                            '</a>' +
                            '</td>' +

                            '<td>' +
                            '<a href="/Student/Edit/' + student.id + '" class="btn btn-warning btn-sm">' +
                            'Edit' +
                            '</a>' +
                            '</td>' +

                            '<td>' +
                            '<a href="/Student/Delete/' + student.id + '" class="btn btn-danger btn-sm">' +
                            'Delete' +
                            '</a>' +
                            '</td>' +

                            '</tr>'

                        );

                    });

                },

                error: function(xhr, status, error) {

                    console.log("AJAX Error:", error);
                    console.log(xhr.responseText);

                }

            });

        });

    });

</script>
}