

@model IEnumerable<GetAllStudentViewModel>
@inject IViewLocalizer _localizer


<script src="~/lib/jquery/jquery.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
@if (TempData["SuccessMessage"] != null)
{

	<script>
		toastr.success('@TempData["SuccessMessage"]');
	</script>
}

@if (TempData["DeleteMessage"] != null)
{

	<script>
		toastr.success('@TempData["DeleteMessage"]');
	</script>
}

@if (TempData["EditMessage"] != null)
{
	<script>
		toastr.success('@TempData["EditMessage"]');
	</script>
}

<div class="alert alert-info">
    Current Culture:
    @System.Globalization.CultureInfo.CurrentCulture.Name
    <br />

    Current UI Culture:
    @System.Globalization.CultureInfo.CurrentUICulture.Name
    <br />

    Gender:
    @_localizer["Gender"]
</div>



<div class="container mt-4">


	<div class="d-flex justify-content-between align-items-center mb-3">

		<h2 class="text-primary fw-bold">
			Students List -------Admin : @ViewBag.Admin
		</h2>


		<form asp-controller="Student"
		asp-action="SearchByGender"
		method="get">

			<div class="input-group">
				<select name="GenderId"
				class="form-select"
				asp-items="@ViewBag.Genders">

					<option value="">-- All Genders --</option>

				</select>

				<button type="submit"
				class="btn btn-outline-primary">

					<i class="bi bi-search"></i>
					Search

				</button>
			</div>

		</form>

        

		<a asp-controller="Student"
		asp-action="Create"
		class="btn btn-success">

			<i class="bi bi-plus-circle"></i>
			Add Student

		</a>

	</div>
	<div class="row g-3 align-items-center mb-4">

		<!-- Normal Search -->
		<div class="col-md-6">
			<form asp-controller="Student"
				  asp-action="Index"
				  method="get"
				  class="d-flex gap-2">

				<div class="input-group">
					<span class="input-group-text bg-white">
						🔍
					</span>

					<input type="text"
						   name="name"
						   value="@Context.Request.Query["name"]"
						   id="searchInput1"
						   class="form-control"
						   placeholder="Search by student name..." />
				</div>

				<button type="submit"
						class="btn btn-primary px-4">
					Search
				</button>

			</form>
		</div>

		<!-- AJAX Search -->
		<div class="col-md-6">
			<input type="text"
				   id="searchInput2"
				   class="form-control"
				   placeholder="Search by student name..." />
		</div>

	</div>

	<div id="studentList">
	@await Html.PartialAsync("_StudentListPartial", Model)
	</div>

<script>
	$(document).ready(function(){
				$("#searchInput2").on("input", function() {
					var searchTerm = $(this).val();
					$.ajax({
						url: '@Url.Action("SearchByName", "Student")',
						type: 'GET',
						data: { name: searchTerm },
						success: function(result) {
							$("#studentList").html(result);
						},
						error: function(xhr, status, error) {
							console.error("AJAX Error: " + status + " - " + error);
						}
					});
				});
})
</script>




@section Script
{
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
}