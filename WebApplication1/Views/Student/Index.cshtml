@model IEnumerable<Student>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="text-primary fw-bold">
            Students List
        </h2>

        <form asp-controller="Student"
              asp-action="SearchByGender"
              method="get">

            <div class="input-group">
                <select name="GenderId"
                        class="form-select"
                        asp-items="@ViewBag.Genders">

                    <option value="">-- All Genders --</option>

                </select>

                <button type="submit"
                        class="btn btn-outline-primary">

                    <i class="bi bi-search"></i>
                    Search

                </button>
            </div>

        </form>

        <a asp-controller="Student"
           asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-circle"></i>
            Add Student

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center">

                    <thead class="table-dark">

                        <tr>

                            <th>ID</th>

                            <th>Name</th>

                            <th>Gender</th>

                            <th>Default Image</th>

                            <th style="min-width: 250px;">
                                Additional Student Images
                            </th>

                            <th colspan="3">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var s in Model)
                        {
                            <tr>

                                <td>
                                    @s.Id
                                </td>


                                <td class="fw-semibold">
                                    @s.Name
                                </td>


                                <td class="fw-semibold">
                                    @s.Gender?.Name
                                </td>


                                <!-- Default Image -->
                                <td>

                                    <img src="/@s.FileUrl"
                                         alt="@s.Name"
                                         class="student-default-image" />

                                </td>


                                <!-- Additional Images -->
                                <td>

                                    <div class="student-images">

                                        @if (s.StudentImages != null &&
                                                                            s.StudentImages.Any())
                                        {
                                            foreach (var file in s.StudentImages)
                                            {
                                                <img src="/@file.FileUrl"
                                                     alt="@s.Name"
                                                     class="student-additional-image" />
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No additional images
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- Details -->
                                <td>

                                    <a asp-controller="Student"
                                       asp-action="Details"
                                       asp-route-id="@s.Id"
                                       class="btn btn-info btn-sm">

                                        Details

                                    </a>

                                </td>


                                <!-- Edit -->
                                <td>

                                    <a asp-controller="Student"
                                       asp-action="Edit"
                                       asp-route-id="@s.Id"
                                       class="btn btn-warning btn-sm">

                                        Edit

                                    </a>

                                </td>


                                <!-- Delete -->
                                <td>

                                    <a asp-controller="Student"
                                       asp-action="Delete"
                                       asp-route-id="@s.Id"
                                       class="btn btn-danger btn-sm">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    /* Default Student Image */

    .student-default-image {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }


    /* Container for additional images */

    .student-images {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        max-width: 300px;
        margin: auto;
    }


    /* Additional images */

    .student-additional-image {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.12);
        transition: 0.2s;
    }


        .student-additional-image:hover {
            transform: scale(1.15);
            box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        }

</style>


@section Script
{
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
}