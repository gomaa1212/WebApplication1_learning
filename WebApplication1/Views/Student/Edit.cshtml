@model UpdateStudentViewModel

@{
    ViewData["Title"] = "Edit Student";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Edit Student</h3>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
						<input type="hidden" asp-for="FileUrl" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="NameEn" class="form-label"></label>
                            <input asp-for="NameEn" class="form-control" />
                            <span asp-validation-for="NameEn" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NameAr" class="form-label"></label>
                            <input asp-for="NameAr" class="form-control" />
                            <span asp-validation-for="NameAr" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GenderId" class="form-label">Gender Type</label>
                            <select asp-for="GenderId" class="form-control" asp-items="ViewBag.Genders"></select>
                            <span asp-validation-for="GenderId" class="text-danger"></span>
                        </div>

                        <div>
                            <img src="/@Model.FileUrl"
                                 alt="@Model.NameEn"
                                 class="student-default-image" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="File" class="form-label">Image URL</label>
                            <input type="file" asp-for="File" class="form-control" />
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>

                        <div class="student-images">

                            @if (Model.currentImages != null )
                                                                
                            {
                                foreach (var file in Model.currentImages)
                                {
                                    <img src="/@file"
             
                                         class="student-additional-image" />
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    No additional images
                                </span>
                            }

                        </div>
                        <div class="mb-3">
                            <label asp-for="Files" class="form-label">Files</label>
                            <input type="file" asp-for="Files" class="form-control" multiple />
                            <span asp-validation-for="Files" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                Back
                            </a>

                            <button type="submit" class="btn btn-success">
                                Edit Student
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>
<style>

    /* Default Student Image */

    .student-default-image {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }


    /* Container for additional images */

    .student-images {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        max-width: 300px;
        margin: auto;
    }


    /* Additional images */

    .student-additional-image {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.12);
        transition: 0.2s;
    }


        .student-additional-image:hover {
            transform: scale(1.15);
            box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        }

</style>
@section Script {
    <partial name="_ValidationScriptsPartial" />
}